# Browser extension backend
browser-extension/backend/token.txt

# Native host: machine-specific, generated from the checked-in .template
browser-extension/native-host/host_dev.bat
browser-extension/native-host/com.twtdl.twtdl_extension.json
browser-extension/native-host/vendor/ffmpeg/
browser-extension/native-host/build/
browser-extension/native-host/dist/

# Installer: built by browser-extension/installer/build.ps1, published as
# GitHub Release assets rather than committed
browser-extension/installer/Output/
browser-extension/installer/twtdl-extension.xpi
browser-extension/installer/signed/

# web-ext sign's cache of the AMO upload UUID for this source dir
browser-extension/extension/.amo-upload-uuid

# Chromium (Chrome/Edge/Brave) build output and native-host dev registration
browser-extension/installer/chromium-build/
browser-extension/native-host/com.twtdl.twtdl_extension.chromium.json
browser-extension/extension-chromium/dev-key/

# Chromium production signing key -- NEVER commit this. Back it up somewhere
# durable outside git; losing it means a new extension ID, leaking it lets
# someone forge "updates" to anyone with the force-install policy applied.
browser-extension/installer/signing/
