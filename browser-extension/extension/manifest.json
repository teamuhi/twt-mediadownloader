{
  "manifest_version": 2,
  "name": "twtdl Downloader",
  "version": "0.6.1",
  "description": "Download Twitter/X media (video, GIF, photo), tweet cards, and YouTube video/audio, via a native messaging host running yt-dlp.",
  "browser_specific_settings": {
    "gecko": {
      "id": "twtdl-extension@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "notifications",
    "nativeMessaging",
    "storage",
    "cookies",
    "*://*.x.com/*",
    "*://*.twitter.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Download media from this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
